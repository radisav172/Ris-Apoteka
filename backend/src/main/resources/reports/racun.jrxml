<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="racun" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="10" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/>
    <style name="Bold" fontName="DejaVu Sans" fontSize="10" isBold="true" pdfFontName="DejaVu Sans Bold" pdfEncoding="Identity-H"/>
    <style name="Title" fontName="DejaVu Sans" fontSize="22" isBold="true" pdfFontName="DejaVu Sans Bold" pdfEncoding="Identity-H"/>

    <parameter name="prodajaId" class="java.lang.Integer"/>
    <parameter name="datum" class="java.lang.String"/>
    <parameter name="korisnik" class="java.lang.String"/>
    <parameter name="pacijent" class="java.lang.String"/>
    <parameter name="ukupnoIznos" class="java.math.BigDecimal"/>

    <field name="naziv" class="java.lang.String"/>
    <field name="kolicina" class="java.lang.Integer"/>
    <field name="cenaProdaje" class="java.math.BigDecimal"/>
    <field name="ukupno" class="java.math.BigDecimal"/>

    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="535" height="40" style="Title"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[RACUN]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="45" width="535" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Broj prodaje: #" + $P{prodajaId} + "   |   Datum: " + $P{datum}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="65" width="260" height="20"/>
                <textFieldExpression><![CDATA["Korisnik: " + $P{korisnik}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="65" width="265" height="20"/>
                <textFieldExpression><![CDATA["Pacijent: " + ($P{pacijent} != null ? $P{pacijent} : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="25" backcolor="#DDDDDD" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="5" y="4" width="245" height="17" style="Bold"/>
                <textElement/>
                <text><![CDATA[Naziv leka]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="4" width="80" height="17" style="Bold"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Kolicina]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="4" width="100" height="17" style="Bold"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Cena (RSD)]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="4" width="100" height="17" style="Bold"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Ukupno (RSD)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="5" y="2" width="245" height="16"/>
                <textFieldExpression><![CDATA[$F{naziv}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="2" width="80" height="16"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{kolicina}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="2" width="100" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{cenaProdaje}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="2" width="100" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{ukupno}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="50">
            <line>
                <reportElement x="330" y="5" width="200" height="1"/>
            </line>
            <staticText>
                <reportElement x="330" y="15" width="100" height="20" style="Bold"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[UKUPNO:]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="15" width="100" height="20" style="Bold"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{ukupnoIznos} + " RSD"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
