<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="karton" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="10" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/>
    <style name="Bold" fontName="DejaVu Sans" fontSize="10" isBold="true" pdfFontName="DejaVu Sans Bold" pdfEncoding="Identity-H"/>
    <style name="Title" fontName="DejaVu Sans" fontSize="20" isBold="true" pdfFontName="DejaVu Sans Bold" pdfEncoding="Identity-H"/>

    <parameter name="ime" class="java.lang.String"/>
    <parameter name="prezime" class="java.lang.String"/>
    <parameter name="jmbg" class="java.lang.String"/>
    <parameter name="datumRodjenja" class="java.lang.String"/>
    <parameter name="kontakt" class="java.lang.String"/>
    <parameter name="alergije" class="java.lang.String"/>

    <field name="datum" class="java.lang.String"/>
    <field name="naziv" class="java.lang.String"/>
    <field name="kolicina" class="java.lang.Integer"/>
    <field name="cenaProdaje" class="java.math.BigDecimal"/>

    <title>
        <band height="150">
            <staticText>
                <reportElement x="0" y="0" width="535" height="35" style="Title"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[KARTON PACIJENTA]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="45" width="265" height="18"/>
                <textFieldExpression><![CDATA["Ime i prezime: " + $P{ime} + " " + $P{prezime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="45" width="265" height="18"/>
                <textFieldExpression><![CDATA["JMBG: " + $P{jmbg}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="65" width="265" height="18"/>
                <textFieldExpression><![CDATA["Datum rodjenja: " + ($P{datumRodjenja} != null ? $P{datumRodjenja} : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="65" width="265" height="18"/>
                <textFieldExpression><![CDATA["Kontakt: " + ($P{kontakt} != null ? $P{kontakt} : "-")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="95" width="100" height="18" style="Bold"/>
                <textElement/>
                <text><![CDATA[Alergije:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="100" y="95" width="435" height="18"/>
                <textFieldExpression><![CDATA[$P{alergije}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="128" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="133" width="535" height="16" style="Bold"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Istorija kupovina]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="25" backcolor="#DDDDDD" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="5" y="4" width="110" height="17" style="Bold"/>
                <textElement/>
                <text><![CDATA[Datum]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="4" width="250" height="17" style="Bold"/>
                <textElement/>
                <text><![CDATA[Naziv leka]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="4" width="70" height="17" style="Bold"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Kolicina]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="4" width="95" height="17" style="Bold"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Cena (RSD)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="5" y="2" width="110" height="16"/>
                <textFieldExpression><![CDATA[$F{datum}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="115" y="2" width="250" height="16"/>
                <textFieldExpression><![CDATA[$F{naziv}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="2" width="70" height="16"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{kolicina}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="2" width="95" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{cenaProdaje}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="535" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Nema evidentiranih kupovina.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
